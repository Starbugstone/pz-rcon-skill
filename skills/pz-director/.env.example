# Project Zomboid Discord-relay configuration
# All real values live ONLY in ~/.env (NOT committed).
# This file is a template for the variables the scripts expect.

# Discord channel for PZ server chat relay — SIMON's broadcasts go here.
# Cron announce delivery posts SIMON's final assistant turn to this channel;
# PZ's Discord chat relay (DiscordEnable=true) mirrors #pz-molt → in-game.
PZ_DISCORD_CHANNEL_ID=

# Discord channel for PZ server console-command relay — mutations go here.
# Post raw commands (no slash prefix) like `players`, `addvehicle <script> <user>`.
# The PZ relay bot echoes the server's response back into the same channel.
# This is the ONLY path for game-state mutations (RCON is deprecated).
PZ_DISCORD_COMMANDS_CHANNEL_ID=

# Discord bot user ID for the PZ server's relay bot — used by the listener
# to filter author identity. Only messages from this account are treated as
# authoritative server responses; all other authors are ignored regardless
# of @mention. The username varies (servertest / pz-server / PZ-Molt-Bot)
# depending on server config — always filter on ID, never on username.
PZ_RELAY_BOT_ID=

# Comma-separated list of enabled server mods (folder names)
PZ_ENABLED_MODS="BreakBigRocks,SKITTLE_LongTermPreservation4220,ImmersiveReading,RVTrailerTypeB42,KI5trailers,damnlib,InjuredZombiesStumble,LEGION18,StarlitLibrary,ProjectArcade,HereGoesTheSun,OCsPacking,DeadMansDossier,ResearchLabInternProfession,70fordEscort,95impreza,96lancerEVO,70roadRunner,69charger,82porsche911,81deloreanDMC12,CrowbarScrewdriverEntry,CorvusNVG,MoodleFramework,DBFaster25,Ladders42131,DBNO_DownButNotOut,SapphCooking_B42,PROJECTRVInterior42,BCR,BCR-IAmNotYourMom,DashRoamerB42,87fordB700,SkillJournal,ZeroWeightKeys_B42,Dry&Cure"

# pz-console.sh polling behavior
#   PZ_CONSOLE_WAIT=0   fire-and-forget (don't poll for response)
#   PZ_CONSOLE_WAIT=1   wait for relay bot response (default)
#   PZ_CONSOLE_TIMEOUT  seconds to wait before giving up (default: 8)
